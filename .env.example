# Кто думает в базе: api | cli | off | auto (api, если есть ключ, иначе off)
UNDERFLOW_LIBRARIAN=auto
ANTHROPIC_API_KEY=
# для cli: долгий токен подписки из `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=

UNDERFLOW_MODEL=claude-opus-5-5
UNDERFLOW_SEARCH_EFFORT=low
UNDERFLOW_CURATE_EFFORT=medium
# серверный фолбэк Anthropic при отказе модели; на прокси и Bedrock/Vertex ставить 0
UNDERFLOW_FALLBACKS=1

# через запятую; пусто = писать может любой
UNDERFLOW_WRITE_TOKENS=
UNDERFLOW_RATE=60
UNDERFLOW_GARDEN_EVERY=3600
# 1 только если сервер стоит за своим прокси, который ставит X-Forwarded-For
UNDERFLOW_TRUST_PROXY=0
